--
-- Table structure for table `background_checks`
--

DROP TABLE IF EXISTS `background_checks`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `background_checks` (
  `id` int NOT NULL AUTO_INCREMENT,
  `application_id` int DEFAULT NULL,
  `offer_id` int DEFAULT NULL,
  `recruiter_id` int DEFAULT NULL,
  `provider` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT 'checkr',
  `provider_candidate_id` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `provider_report_id` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `status` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT 'pending',
  `verdict` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `findings` text COLLATE utf8mb4_unicode_ci,
  `report_url` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `candidate_notified_at` datetime DEFAULT NULL,
  `completed_at` datetime DEFAULT NULL,
  `created_at` datetime DEFAULT NULL,
  `updated_at` datetime DEFAULT NULL,
  `company_id` int NOT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_bg_app` (`application_id`),
  KEY `idx_bg_offer` (`offer_id`),
  KEY `idx_bg_recruiter` (`recruiter_id`),
  KEY `idx_bg_status` (`status`),
  KEY `ix_background_checks_company_id` (`company_id`),
  CONSTRAINT `fk_background_checks_application` FOREIGN KEY (`application_id`) REFERENCES `applications` (`id`) ON DELETE CASCADE,
  CONSTRAINT `fk_background_checks_company` FOREIGN KEY (`company_id`) REFERENCES `companies` (`id`) ON DELETE RESTRICT,
  CONSTRAINT `fk_background_checks_offer` FOREIGN KEY (`offer_id`) REFERENCES `offers` (`id`) ON DELETE SET NULL,
  CONSTRAINT `fk_background_checks_recruiter` FOREIGN KEY (`recruiter_id`) REFERENCES `users` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

--
-- Dumping data for table `background_checks`
--

LOCK TABLES `background_checks` WRITE;
/*!40000 ALTER TABLE `background_checks` DISABLE KEYS */;
/*!40000 ALTER TABLE `background_checks` ENABLE KEYS */;
UNLOCK TABLES;

--
-- Table structure for table `batch_jobs`
--

DROP TABLE IF EXISTS `batch_jobs`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `batch_jobs` (
  `id` int NOT NULL AUTO_INCREMENT,
  `recruiter_id` int DEFAULT NULL,
  `title` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `target_role` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `description` text COLLATE utf8mb4_unicode_ci,
  `language` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `status` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `worker_status` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `error_message` text COLLATE utf8mb4_unicode_ci,
  `created_at` datetime DEFAULT NULL,
  `deleted_at` datetime DEFAULT NULL,
  `job_id` int NOT NULL,
  `company_id` int NOT NULL,
  `rubric_id` int DEFAULT NULL,
  `active_snapshot_id` int DEFAULT NULL,
  `duration_minutes` int DEFAULT NULL,
  `difficulty` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `candidate_source` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `location` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `cv_processing_consent_confirmed` tinyint(1) NOT NULL DEFAULT '0',
  `cv_processing_consent_confirmed_at` datetime DEFAULT NULL,
  `cv_processing_consent_confirmed_by` int DEFAULT NULL,
  `interview_instructions` text COLLATE utf8mb4_unicode_ci,
  `template_id` int DEFAULT NULL,
  `email_sequence_enabled` tinyint(1) DEFAULT '0',
  `email_sequence_days` text COLLATE utf8mb4_unicode_ci,
  PRIMARY KEY (`id`),
  KEY `ix_batch_jobs_created_at` (`created_at`),
  KEY `ix_batch_jobs_deleted_at` (`deleted_at`),
  KEY `ix_batch_jobs_id` (`id`),
  KEY `ix_batch_jobs_recruiter_id` (`recruiter_id`),
  KEY `ix_batch_jobs_status` (`status`),
  KEY `ix_batch_jobs_worker_status` (`worker_status`),
  KEY `fk_batch_job_job` (`job_id`),
  KEY `idx_batch_jobs_company_id` (`company_id`),
  KEY `ix_batch_jobs_rubric_id` (`rubric_id`),
  KEY `active_snapshot_id` (`active_snapshot_id`),
  KEY `idx_batch_jobs_template` (`template_id`),
  CONSTRAINT `batch_jobs_ibfk_1` FOREIGN KEY (`recruiter_id`) REFERENCES `users` (`id`),
  CONSTRAINT `batch_jobs_ibfk_2` FOREIGN KEY (`company_id`) REFERENCES `companies` (`id`),
  CONSTRAINT `batch_jobs_ibfk_3` FOREIGN KEY (`rubric_id`) REFERENCES `rubrics` (`id`),
  CONSTRAINT `batch_jobs_ibfk_4` FOREIGN KEY (`active_snapshot_id`) REFERENCES `evaluation_config_snapshots` (`id`),
  CONSTRAINT `fk_batch_job_job` FOREIGN KEY (`job_id`) REFERENCES `jobs` (`id`),
