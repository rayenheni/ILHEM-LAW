INSERT INTO `cv_documents` VALUES (1,2,NULL,NULL,'C E O  -  M o u s a w a 9  J a n v i e r  2 0 2 3  -  A o u t  2 0 2 5\nP r o s p e c t i o n  p a r  t é l é p h o n e  e t  p a r  e - m a i l i n g ,  a l i m e n t a t i o n  d e s  b a s e s  d e  d o n n é e s ,  é t a b l i s s e m e n t  d e\nr e p o r t i n g s .\nA n a l y s e  d e s  d o n n é e s  m a r k e t i n g  p o u r  s e g m e n t e r  e t  c i b l e r  e f f i c a c e m e n t  l e s  a u d i e n c e s .  C r é a t i o n  d e\nc a m p a g n e s  p u b l i c i t a i r e s  m u l t i m é d i a s  ( n u m é r i q u e s ,  i m p r i m é e s ,  t é l é v i s u e l l e s )  p o u r  d i f f é r e n t s  p r o d u i t s  o u\ns e r v i c e s .  R é a l i s a t i o n  d \' é t u d e s  d e  m a r c h é  q u a l i t a t i v e s  e t  q u a n t i t a t i v e s  p o u r  o r i e n t e r  l e s  d é c i s i o n s\nm a r k e t i n g .\nC o o r d i n a t i o n  a v e c  l e s  é q u i p e s  d e  v e n t e  e t  d e  p r o d u c t i o n  p o u r  o p t i m i s e r  l e s  e f f o r t s  m a r k e t i n g .\nI d e n t i f i c a t i o n  e t  n é g o c i a t i o n  d e  p a r t e n a r i a t s  s t r a t é g i q u e s  a f i n  d \' a c c r o î t r e  l a  n o t o r i é t é  d e  l \' e n t r e p r i s e .\nR e s p o n s a b l e  M a r k e t i n g  -  L e u c i l l i n  s a  A o u t  2 0 2 4  -  J a n v i e r  2 0 2 5\nÉ l a b o r a t i o n  d e  s t r a t é g i e s  d e  c o m m u n i c a t i o n  e t  m a r k e t i n g  p o u r  p r o m o u v o i r  l e s  p r o d u i t s  d e  s o i n  d e  l a\np e a u d e  l a  m a r q u e .\nC r é a t i o n  d e  c a m p a g n e s  p u b l i c i t a i r e s  s u r  l e s  r é s e a u x  s o c i a u x  e t  a u t r e s  p l a t e f o r m e s  d i g i t a l e s .\nC o o r d i n a t i o n  a v e c  l e s  é q u i p e s  c o m m e r c i a l e s  p o u r  a s s u r e r  l a  m i s e  e n  p l a c e  d e  p r o m o t i o n s  e t  d e\np a r t e n a r i a t s  s t r a t é g i q u e s .\nA u g m e n t a t i o n  d e  l a  v i s i b i l i t é  d e  l a  m a r q u e  e t  d e  s o n  e n g a g e m e n t  c l i e n t  à  t r a v e r s  d e s  i n i t i a t i v e s  d e\nm a r k e t i n g  d i g i t a l .\n \nJ a n v i e r  -  F é v r i e r  2 0 2 5\nm o n j i  s l i m  s i l i a n a  |  r a y e n h e n i 8 @ g m a i l . c o m\nP r o f e s s i o n n e l  d o t é  d e  n o m b r e u s e s  a n n é e s  d \' e x p é r i e n c e  d a n s  l \' e - c o m m e r c e  ,  c o m b i n é e s  à  u n e  s o l i d e\nf o r m a t i o n  d a n s  l e s  t e c h n i q u e s  d e  v e n t e s  e t  u n e  f o r t e  a p t i t u d e  à  a c q u é r i r  d e  n o u v e l l e s  c o n n a i s s a n c e s .  C a p a b l e\nà  l a  f o i s  d e  t r a v a i l l e r  e n  é q u i p e  e t  d e  f o n c t i o n n e r  d e  m a n i è r e  a u t o n o m e ,  j e  f a i s  p r e u v e  d \' u n  s o l i d e  s e n s  d e\nl \' o r g a n i s a t i o n  e t  d e  c o m p é t e n c e s  a v é r é e s  e n  m a r k e t i n g  d i g i t a l e  e t  l \' a n a l y s e  d e s  p e r f o r m a n c e s  .\nE X P É R I E N C E  P R O F E S S I O N N E L L E\nC o m m u n i t y  M a n a g e r  e t  S o c i a l  M e d i a  M a n a g e r - T a t w e e r s o f t\nG e s t i o n  d e s  m é d i a s  s o c i a u x  e t  d e s  c o m m u n i c a t i o n s  n u m é r i q u e s  p o u r  p r o m o u v o i r  l e s  s o l u t i o n s\nl o g i c i e l l e s  d e  l \' e n t r e p r i s e .  \nC r é a t i o n  d e  c o n t e n u  i n f o r m a t i f  e t  e n g a g e a n t  p o u r  a t t i r e r  d e s  p r o s p e c t s  q u a l i f i é s  d a n s  l e  d o m a i n e\nd e s  t e c h n o l o g i e s .  \nM i s e  e n  p l a c e  d e  s t r a t é g i e s  d e  c r o i s s a n c e  o r g a n i q u e  e t  p a y a n t e  p o u r  r e n f o r c e r  l a  p r é s e n c e  d e  l a\nm a r q u e  e n  l i g n e .  \nA n a l y s e  d e s  r é s u l t a t s  d e s  c a m p a g n e s  p o u r  o p t i m i s e r  l a  s t r a t é g i e  e t  a c c r o î t r e  l e s  c o n v e r s i o n s .\nR A Y E N  E L H E N I\n R E S P O N S A B L E  M A R K E T I N G  \nG e s t i o n  d \' é q u i p e  \nV i s i o n  e n t r e p r e n e u r i a l e\nA n a l y s e  d e  d o n n é e s\nM a r k e t i n g  d i g i t a l\nE - c o m m e r c e  l o c a l e  \nD e s i g n  g r a p h i q u e\nC O M P É T E N C E S\n\nL i c e n s e  e n  c o m m e r c e  e t  d i s t r i b u t i o n  -  T e c h n i q u e s  d e  v e n t e  \ni n s t i t u t  s u p é r i e u r  d e s  e t u d e s  t e c h n o l o g i q u e  s i l i a n a\nb a c c a l a u r é a t  s e c t i o n  t e c h n i q u e  \nm o n j i  s l i m  s i l i a n a\nL a n g u e s :  A n g l a i s ,  F r a n ç a i s ,  A r a b e  .\nC e r t i f i c a t i o n s :  O n e  m i l l i o n  a r a b i c  c o d e r s  c e r t i f i c a t  ,  b a s i c  o f  m a r k e t i n g  d i g i t a l e  b y  g o o g l e  .  \nA w a r d s / A c t i v i t i e s :  g a g n a n t  d e  b o o t c a m p  “  b u s i n e s s  p l a n  “  c e n t r e  e l i f  s i l i a n a  ,  p r o j e t  s u b v e n t i o n n é  p a r\nc i n e m a r e n a  I O M  \nS e p  2 0 2 2  -  j u i n  2 0 2 5\nS e p  2 0 2 1  -  J u i n  2 0 2 2\nS t a g i a i r e  |  T u n i s i e  t é l é c o m J a n  2 0 2 3  -  F é v  2 0 2 3\nA d a p t a t i o n  r a p i d e  à  d i f f é r e n t s  i n t e r l o c u t e u r s  e t  d i f f é r e n t e s  s i t u a t i o n s .\nC o l l a b o r a t i o n  e n  é q u i p e  e n  c o m m u n i q u a n t ,  e n  p a r t a g e a n t  l e s  i d é e s  e t  e n  m u t u a l i s a n t  l e s  e f f o r t s .\nT r a n s m i s s i o n  e t  c o m m u n i c a t i o n  d e s  i n f o r m a t i o n s  a u x  c o l l a b o r a t e u r s  d e  m a n i è r e  c l a i r e  a f i n  d e\nf a c i l i t e r  l a  c o n t i n u i t é  d e s  o p é r a t i o n s .\nR é s o l u t i o n  d e s  p r o b l è m e s  e t  a m é l i o r a t i o n  d e s  o p é r a t i o n s  e n  f o u r n i s s a n t  u n  s e r v i c e  e x c e p t i o n n e l .\nE D U C A T I O N\nI N F O R M A T I O N S  C O M P L É M E N T A I R E S\nS t a g i a i r e  |  P o s t e  T u n i s i e n n e  J a n  2 0 2 3  -  F é v  2 0 2 3\nD é c o u v e r t e  d u  p r o c e s s u s  d e  g e s t i o n  c l i e n t  e t  d e s  s e r v i c e s  c o m m e r c i a u x .\nO b s e r v a t i o n  d e s  t e c h n i q u e s  d e  v e n t e  e t  d e s  p r o c é d u r e s  d ’ a b o n n e m e n t .\nI n i t i a t i o n  à  l ’ a c c u e i l  c l i e n t ,  g e s t i o n  d e s  d o s s i e r s  e t  o u t i l s  C R M .','[]',NULL,'{\"name\": \"Monjislim Siliana\", \"role\": \"Community Manager / Social Media Manager\", \"email\": \"rayenheni8@gmail.com\", \"score\": 0, \"skills\": [\"Community Management\", \"Social Media Marketing\", \"Content Creation\", \"Campaign Management\", \"Metrics Tracking & Reporting\"], \"summary\": \"Monjislim Siliana is a community and social media manager with strong marketing and analytics experience, but her background does not align with HR talent acquisition or onboarding responsibilities.\", \"rationale\": \"The candidate’s experience is focused on marketing and community engagement, which is unrelated to the HR and talent acquisition skills required by the rubric, resulting in a zero score.\", \"rubric_match\": {\"rubric_id\": 3, \"rubric_title\": \"HR Specialist manager\", \"total_skills\": 10, \"matched_skills\": [], \"missing_skills\": [{\"name\": \"Sourcing & Candidate Pipeline\", \"category\": \"Talent Acquisition & Onboarding\"}, {\"name\": \"Structured Interviewing\", \"category\": \"Talent Acquisition & Onboarding\"}, {\"name\": \"Onboarding Execution\", \"category\": \"Talent Acquisition & Onboarding\"}, {\"name\": \"HRIS Data Accuracy\", \"category\": \"Operational Compliance & HRIS Management\"}, {\"name\": \"Record Keeping & Documentation\", \"category\": \"Operational Compliance & HRIS Management\"}, {\"name\": \"Basic Labor Law Alignment\", \"category\": \"Operational Compliance & HRIS Management\"}, {\"name\": \"First‑line Staff Inquiries\", \"category\": \"Employee Relations & Support\"}, {\"name\": \"Conflict Resolution & Mediation\", \"category\": \"Employee Relations & Support\"}, {\"name\": \"Metrics Tracking & Reporting\", \"category\": \"Process Improvement & Reporting\"}, {\"name\": \"Continuous Process Optimization\", \"category\": \"Process Improvement & Reporting\"}], \"match_percentage\": 0}, \"matched_rubric_skills\": [\"Metrics Tracking & Reporting\"], \"missing_rubric_skills\": [\"Sourcing & Candidate Pipeline\", \"Structured Interviewing\", \"Onboarding Execution\", \"HRIS Data Accuracy\", \"Record Keeping & Documentation\", \"Basic Labor Law Alignment\", \"First‐line Staff Inquiries\", \"Conflict Resolution & Mediation\", \"Continuous Process Optimization\"]}',NULL,NULL,NULL,NULL,'2026-08-24 15:49:39','2026-08-24 15:49:39',1,NULL,5),(2,3,NULL,NULL,'Synthetic HR Specialist CV for Candway QA testing\nPage 1\n[NAME_REDACTED]\nHR [NAME_REDACTED], Tunisia · [EMAIL_REDACTED] ·  [PHONE_REDACTED] [NAME_REDACTED]\nHR Specialist with 5+ years of experience supporting recruitment, onboarding, employee relations, HR administration,\ntraining coordination, and HR reporting for fast-growing service and technology companies. Strong ability to manage\nhiring pipelines, coordinate interviews, maintain employee records, and support managers with structured people\noperations.\n[NAME_REDACTED] coordination · Candidate screening · Interview scheduling · Onboarding · Employee relations · HR\nadministration · HRIS · Payroll support · Training coordination · Labor law basics · Performance review support · HR\nreporting · Internal communication · Conflict resolution · Excel / [NAME_REDACTED] · ATS tools\n[NAME_REDACTED]\nHR Specialist — [NAME_REDACTED] (2022 – 2026)\n Managed end-to-end recruitment coordination for customer support, sales, operations, and junior technical roles.\n Screened CVs, scheduled interviews, coordinated hiring manager feedback, and maintained candidate pipelines in the\nATS.\n Improved onboarding completion rate by introducing a structured checklist for contracts, documents, IT access, and\nfirst-week training.\n Supported employee relations cases by documenting issues, coordinating manager discussions, and following internal\nHR policies.\n Prepared monthly HR reports covering headcount, turnover, recruitment cycle time, attendance issues, and onboarding\nprogress.\nHR Coordinator — [NAME_REDACTED] (2019 – 2022)\n Coordinated recruitment campaigns for internships, junior developers, support agents, and administrative roles.\n Maintained employee records, contracts, leave requests, and HR documentation with high accuracy.\n Organized training sessions and tracked participation, feedback, and completion certificates.\n Assisted payroll preparation by validating attendance, overtime, absence records, and employee changes.\n Created dashboards in Excel to monitor hiring status, probation periods, and document completeness.\nHR Assistant — [NAME_REDACTED] (2017 – 2019)\n Assisted with CV screening, phone pre-qualification, interview scheduling, and candidate communication.\n Prepared HR letters, employee files, onboarding documents, and internal announcements.\n Supported office administration and employee engagement activities.\nEducation & Certifications\n Master in [NAME_REDACTED] — ISG Tunis\n Bachelor in [NAME_REDACTED] — Université de Tunis\n HR [NAME_REDACTED]\n Recruitment & [NAME_REDACTED] — native · French — fluent · English — professional','[]',NULL,'{\"name\": \"Unknown Candidate\", \"role\": \"General\", \"email\": null, \"score\": 0, \"skills\": [], \"summary\": \"Failed to extract details.\", \"rubric_match\": {\"rubric_id\": 3, \"rubric_title\": \"HR Specialist manager\", \"total_skills\": 10, \"matched_skills\": [{\"name\": \"Onboarding Execution\", \"category\": \"Talent Acquisition & Onboarding\"}, {\"name\": \"HRIS Data Accuracy\", \"category\": \"Operational Compliance & HRIS Management\"}], \"missing_skills\": [{\"name\": \"Sourcing & Candidate Pipeline\", \"category\": \"Talent Acquisition & Onboarding\"}, {\"name\": \"Structured Interviewing\", \"category\": \"Talent Acquisition & Onboarding\"}, {\"name\": \"Record Keeping & Documentation\", \"category\": \"Operational Compliance & HRIS Management\"}, {\"name\": \"Basic Labor Law Alignment\", \"category\": \"Operational Compliance & HRIS Management\"}, {\"name\": \"First‑line Staff Inquiries\", \"category\": \"Employee Relations & Support\"}, {\"name\": \"Conflict Resolution & Mediation\", \"category\": \"Employee Relations & Support\"}, {\"name\": \"Metrics Tracking & Reporting\", \"category\": \"Process Improvement & Reporting\"}, {\"name\": \"Continuous Process Optimization\", \"category\": \"Process Improvement & Reporting\"}], \"match_percentage\": 20}}',NULL,NULL,NULL,NULL,'2026-08-24 15:55:07','2026-08-24 15:55:07',1,NULL,5),(3,4,NULL,NULL,'Synthetic CV for Candway QA testing — designed to match [NAME_REDACTED] + HRIS [NAME_REDACTED] 1\n[NAME_REDACTED]\nHR Onboarding & HRIS [NAME_REDACTED], Tunisia · [EMAIL_REDACTED] ·  [PHONE_REDACTED] [NAME_REDACTED]\nHR operations assistant with 3 years of experience focused on onboarding execution and HRIS data accuracy.\nExperienced in preparing new-hire onboarding steps, coordinating induction sessions, updating employee master data,\nand keeping HRIS information accurate across employee lifecycle changes.\n[NAME_REDACTED] · [NAME_REDACTED] · [NAME_REDACTED] · [NAME_REDACTED] · HRIS [NAME_REDACTED] ·\n[NAME_REDACTED] · HRIS [NAME_REDACTED] · HRIS [NAME_REDACTED] · Start-[NAME_REDACTED] · [NAME_REDACTED] · Internal HR [NAME_REDACTED]\nHR [NAME_REDACTED] — [NAME_REDACTED] (2023 – 2026)\n Coordinated onboarding execution for new employees joining customer support, operations, and back-office teams.\n Prepared onboarding task lists covering welcome sessions, account requests, equipment handover, and first-week\norientation steps.\n Updated HRIS employee profiles with accurate department, manager, role, start date, contract type, and contact\ninformation.\n Performed regular HRIS data accuracy checks to identify incomplete fields, duplicate entries, and outdated employee\ninformation.\n Worked with HR coordinators and team leads to ensure new hires completed their onboarding steps on time.\n[NAME_REDACTED] — [NAME_REDACTED] (2021 – 2023)\n Supported onboarding execution for junior staff by coordinating orientation meetings and internal access requests.\n Maintained accurate employee master data in the HRIS during hiring, internal transfer, probation completion, and exit\npreparation.\n Helped prepare welcome materials and practical onboarding instructions for new hi[ADDRESS_REDACTED]prove accuracy of employee profiles and organizational charts.\n Coordinated with IT, office management, and HR team members to ensure onboarding tasks were completed before the\nemployee start date.\nAdministrative HR Intern — [NAME_REDACTED] (2020 – 2021)\n Assisted the HR team with new employee setup, induction scheduling, and HRIS updates.\n Checked employee profile information for accuracy and flagged missing HRIS fields to the HR coordinator.\nEducation & Certifications\n Bachelor in [NAME_REDACTED] — Université de Tunis\n HRIS [NAME_REDACTED]\n [NAME_REDACTED] [NAME_REDACTED] — native · French — fluent · English — professional','[]',NULL,'{\"name\": \"Unknown Candidate\", \"role\": \"General\", \"email\": null, \"score\": 0, \"skills\": [], \"summary\": \"Failed to extract details.\", \"rubric_match\": {\"rubric_id\": 3, \"rubric_title\": \"HR Specialist manager\", \"total_skills\": 10, \"matched_skills\": [{\"name\": \"Onboarding Execution\", \"category\": \"Talent Acquisition & Onboarding\"}, {\"name\": \"HRIS Data Accuracy\", \"category\": \"Operational Compliance & HRIS Management\"}], \"missing_skills\": [{\"name\"