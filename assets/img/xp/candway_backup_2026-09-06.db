  CONSTRAINT `fk_rubric_job` FOREIGN KEY (`job_id`) REFERENCES `jobs` (`id`),
  CONSTRAINT `rubrics_ibfk_1` FOREIGN KEY (`company_id`) REFERENCES `companies` (`id`),
  CONSTRAINT `ck_rubric_max_score_non_negative` CHECK (((`max_score` is null) or (`max_score` >= 0))),
  CONSTRAINT `ck_rubric_passing_score_non_negative` CHECK (((`passing_score` is null) or (`passing_score` >= 0))),
  CONSTRAINT `ck_rubric_weight_non_negative` CHECK (((`weight` is null) or (`weight` >= 0)))
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
