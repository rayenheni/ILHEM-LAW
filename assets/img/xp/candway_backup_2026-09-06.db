--
-- Table structure for table `jobs`
--

DROP TABLE IF EXISTS `jobs`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `jobs` (
  `id` int NOT NULL AUTO_INCREMENT,
  `recruiter_id` int DEFAULT NULL,
  `category_id` int DEFAULT NULL,
  `title` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `company_name` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `location` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `salary_range` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `type` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `description` text COLLATE utf8mb4_unicode_ci,
  `required_skills` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `created_at` datetime DEFAULT NULL,
  `is_active` tinyint(1) DEFAULT NULL,
  `deleted_at` datetime DEFAULT NULL,
  `views` int DEFAULT NULL,
  `valid_through` datetime DEFAULT NULL,
  `job_category_id` int DEFAULT NULL,
  `version_id` int NOT NULL DEFAULT '1',
  `company_id` int NOT NULL,
  `total_questions` int DEFAULT NULL,
  `time_limit_seconds` int DEFAULT NULL,
  `duration_minutes` int DEFAULT NULL,
  `interview_instructions` text COLLATE utf8mb4_unicode_ci,
  `custom_question_prompt` text COLLATE utf8mb4_unicode_ci,
  `rubric_id` int DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `category_id` (`category_id`),
  KEY `ix_jobs_created_at` (`created_at`),
  KEY `ix_jobs_deleted_at` (`deleted_at`),
  KEY `ix_jobs_id` (`id`),
  KEY `ix_jobs_is_active` (`is_active`),
  KEY `ix_jobs_recruiter_id` (`recruiter_id`),
  KEY `ix_jobs_type` (`type`),
  KEY `idx_jobs_job_category` (`job_category_id`),
  KEY `idx_jobs_company_id` (`company_id`),
  KEY `idx_jobs_rubric` (`rubric_id`),
  CONSTRAINT `fk_jobs_recruiter_id` FOREIGN KEY (`recruiter_id`) REFERENCES `users` (`id`) ON DELETE SET NULL,
  CONSTRAINT `fk_jobs_rubric_id` FOREIGN KEY (`rubric_id`) REFERENCES `rubrics` (`id`) ON DELETE SET NULL,
  CONSTRAINT `jobs_ibfk_1` FOREIGN KEY (`category_id`) REFERENCES `categories` (`id`),
  CONSTRAINT `jobs_ibfk_3` FOREIGN KEY (`job_category_id`) REFERENCES `job_categories` (`id`),
  CONSTRAINT `jobs_ibfk_4` FOREIGN KEY (`company_id`) REFERENCES `companies` (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

