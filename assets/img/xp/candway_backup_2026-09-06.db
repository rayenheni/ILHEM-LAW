LOCK TABLES `jobs` WRITE;
/*!40000 ALTER TABLE `jobs` DISABLE KEYS */;
INSERT INTO `jobs` VALUES (1,9,NULL,'Marketing Lead','السيد','Tunisie','2000–2000 USD','full-time','<h3>90-Day Outcomes</h3>\n<p>الأيام 1 - 30: مرحلة الاستكشاف والاندماج (Onboarding & Audit)المخرج الأساسي: إعداد تقرير تدقيق شامل (Audit Report) يحلل الوضع الحالي للحملات السابقة، حسابات التواصل الاجتماعي، والموقع الإلكتروني.فهم كامل للمنتج/الخدمة، وتحديد دقيق لشخصية العميل التونسي المستهدف (Buyer Persona).عقد اجتماعات فردية مع أعضاء فريق التسويق وفريق المبيعات لفهم نقاط القوة والضعف في منظومة العمل.الأيام 31 - 60: التخطيط وإطلاق الحملات الأولى (Strategy & Execution)المخرج الأساسي: إطلاق أول خطة تسويقية متكاملة لمدة 3 أشهر (Q1 Marketing Plan).إعادة هيكلة حسابات الإعلانات والبدء في اختبار رسائل تسويقية جديدة تناسب اللهجة والاهتمامات المحلية (A/B Testing).وضع آلية واضحة ومؤتمتة (اتصال مباشر، واتساب، أو CRM) لنقل الـ Leads الناتجة عن التسويق إلى فريق المبيعات بسرعة.الأيام 61 - 90: التحسين وتحقيق النتائج (Optimization & Scaling)المخرج الأساسي: تحقيق استقرار في تدفق الفرص البيعية الزبائنية مع تقليل تكلفة الـ Lead بنسبة 15% على الأقل مقارنة بالفترة التي سبقت استلام الدور.تقديم أول تقرير أداء شهري متكامل يحتوي على أرقام واضحة (الميزانية المستهلكة، عدد الزوار، عدد الـ Leads، ونسبة التحول لمبيعات).بناء خطة لتطوير مهارات الفريق لمواكبة التحديثات الجديدة في المنصات الإعلانية.</p>\n\n<h3>Problems Solved</h3>\n<p>ضعف جودة الـ Leads: إنهاء مشكلة جلب مئات التعليقات غير الجدية (مثل: \"قداش السعر؟\" دون شراء) عبر التركيز على استهداف دقيق ومحتوى يصف القيمة الحقيقية للمنتج.غياب الرؤية والبيانات: تحويل التسويق من مجرد \"نشر منشورات عشوائية\" إلى عملية علمية تعتمد على الأرقام، وحساب تكلفة كل دينار يتم إنفاقه وجهته.ضعف التنسيق الداخلي: حل الفجوة التقليدية بين فريق التسويق وفريق المبيعات، وضمان أن المبيعات تتلقى معلومات كافية وجاهزة لإغلاق الصفقات.محدودية الوصول والانتشار: كسر جمود نمو العلامة التجارية في السوق التونسية المزدحمة عبر أفكار إبداعية وحملات تفاعلية تميز الشركة عن المنافسين.</p>\n\n<h3>Key Responsibilities</h3>\n<p>بناء وإدارة الاستراتيجية الرقمية: تصميم وإدارة حملات الإعلانات المدفوعة عبر المنصات الأكثر استخداماً في تونس (Facebook Ads, Instagram, TikTok, LinkedIn) مع تكييف الخطاب الثقافي ليناسب الجمهور المستهدف.إدارة وتطوير فريق العمل: الإشراف اليومي على صانعي المحتوى والمصممين، وتوزيع المهام، وتقديم الدعم والتوجيه لضمان جودة المخرجات.تحسين الميزانية والتكلفة: إدارة ميزانية التسويق بدقة، والعمل على خفض تكلفة الاستحواذ على العميل (CAC) ورفع العائد على الاستثمار الإعلاني (ROAS).التسويق التقليدي والعلاقات العامة (إن لزم): التنسيق لإعلانات الشوارع (Affichage Urbain)، أو رعاية الأحداث والفعاليات المحلية، وإدارة العلاقات مع المؤثرين التونسيين (Influencer Marketing).تحليل البيانات وإعداد التقارير: مراقبة مؤشرات الأداء (KPIs) بشكل أسبوعي وشهري، وتقديم تقارير دقيقة للإدارة العامة حول أداء الحملات والمبيعات المحققة عبر القنوات التسويقية.</p>\n\n<h3>Success Criteria</h3>\n<p>يقاس نجاح الـ Marketing Lead سنوياً ونصف سنوياً بناءً على المؤشرات التالية:نمو المبيعات (Revenue Growth): نسبة نمو المبيعات الإجمالية الناتجة بشكل مباشر عن قنوات التسويق.العائد على الإنفاق الإعلاني (ROAS): تحقيق معدل مستهدف (مثلاً: 3x أو 4x) لكل دينار تونسي يُنفق على الإعلانات.تكلفة الاستحواذ (CAC): الحفاظ على تكلفة جذب العميل الجديد ضمن الحدود الربحية المتفق عليها مع الإدارة المالية.استبقاء ومعدل دوران الفريق (Team Retention): الحفاظ على تماسك فريق التسويق، ورفع مستوى رضاهم وإنتاجيتهم وتطورهم المهني.</p>','marketing lead Core Expertise, Tools & Methodologies, Problem Solving, Communication, Collaboration, Adaptability, Delivering Results, Leadership','2026-08-23 10:25:52',1,NULL,5,NULL,NULL,11,4,6,1800,30,'تتحكم القواعد التالية في طريقة تحليل وتقييم إجابات المترشحين:التقييم القائم على الأدلة (Evidence-Based Scoring): لا يتم احتساب أي مهارة أو خبرة ما لم يذكر المترشح دليلاً ملموساً عليها (مثال: أرقام حملات، أدوات مستخدمة مثل Meta Ads Manager، أو نسب نمو محققة).إعطاء الأولوية للمهارات التي تم التحقق منها (Prioritize Verified Skills): يتم منح وزن أعلى (Weight) في النقاط للمهارات المثبتة عبر اختبارات تقنية مسبقة أو مشاريع سابقة موثقة.تفسير القرارات (Explain AI Decisions): يلتزم النظام بتقديم تقرير تعليلي (Reasoning Breakdown) لكل درجة يتم منحها، يوضح نقاط القوة والفجوات بناءً على إجابة المترشح.',NULL,1),(2,13,NULL,'HR spécialiste ','السيد','Tunisie','2500–3000 USD','part-time','<h3>90-Day Outcomes</h3>\n<p>Day 30: Learn all internal HR software, policies, and team workflows.Day 60: Manage the full recruitment process for active open roles.Day 90: Own employee onboarding end-to-end and resolve basic HR tickets independently.</p>\n\n<h3>Problems Solved</h3>\n<p>Slow hiring: Speed up time-to-hire by organizing the interview pipeline.Unclear policies: Answer employee doubts about benefits and time off.Messy records: Fix and organize worker files in the HR database.</p>\n\n<h3>Key Responsibilities</h3>\n<p>Hiring: Write job ads, screen resumes, and schedule interviews.Onboarding: Welcome new hires, set up profiles, and run orientation.Operations: Update employee records and manage HR systems.Support: Answer employee questions about pay, time off, and benefits.Compliance: Follow local labor laws and company rules.</p>\n\n<h3>Success Criteria</h3>\n<p>peed: Fill open jobs in under 45 days on average.Accuracy: Keep zero errors in personnel files and payroll data.Satisfaction: Maintain a high new-hire onboarding feedback score.</p>','management','2026-08-23 21:21:21',1,NULL,7,NULL,NULL,11,4,6,1800,30,NULL,NULL,2),(3,15,NULL,'HR Specialist MANAGER','mousawa9','Tunisie','24680–24680 USD','full-time',NULL,NULL,'2026-08-24 05:55:49',0,NULL,0,NULL,NULL,9,5,6,1800,30,'- **Startup Mindset:** Prioritize candidates with startup experience who can handle ambiguity, wear multiple hats, and thrive in fast-paced, rapidly changing environments.\n- **Tools over Theory:** Favor candidates with practical hands-on experience in modern HR platforms (e.g., Rippling, Gusto, BambooHR, Greenhouse) over theoretical strategic frameworks.\n- **Scrappiness & Ownership:** Look for a proactive \"builder\" mentality—someone who sets up systems from scratch rather than just maintaining existing corporate processes.\n- **Speed & Agility:** Emphasize high-volume sourcing speed, rapid interview scheduling, and fast turnaround times for employee requests.\n',NULL,3),(4,15,NULL,'community manager','mousawa9','Tunisie','3000–4500 USD','internship','<h3>Résultats à 90 jours</h3>\n<p>Mettre en place un calendrier éditorial structuré et une routine de publication régulière.\nAugmenter significativement l’engagement et la croissance des communautés.\nConstruire une communauté plus active autour de la marque.\nIdentifier les formats et sujets générant le meilleur engagement.\nGénérer un flux régulier de contenu et d\'interactions qualifiées.\nMettre en place un reporting simple avec les principaux KPI et recommandations d\'amélioration.</p>\n\n<h3>Problèmes résolus</h3>\n<p>Une présence social media irrégulière ou peu structurée.\nUn faible niveau d\'engagement avec la communauté.\nUn manque de contenu adapté aux différentes plateformes.\nUne faible visibilité et croissance organique de la marque.\nL\'absence de suivi clair des performances des réseaux sociaux.\nUne communauté passive qui interagit peu avec la marque.</p>\n\n<h3>Responsabilités clés</h3>\n<p>Gérer et développer les communautés de la marque sur Facebook, Instagram, LinkedIn et TikTok.\nCréer et publier régulièrement du contenu adapté à chaque plateforme.\nAnimer la communauté : répondre aux commentaires et messages, lancer des discussions et encourager l’engagement.\nDévelopper une relation forte avec les membres et transformer les abonnés en communauté active.\nSuivre les tendances, identifier les opportunités de contenu et proposer de nouvelles idées.\nCollaborer avec l’équipe marketing pour aligner le contenu avec les objectifs de la marque.\nSuivre les performances des publications et optimiser la stratégie selon les résultats.</p>\n\n<h3>Critères de succès</h3>\n<p>Croissance mensuelle des abonnés et de la communauté.\nTaux d\'engagement des publications.\nNombre et qualité des interactions : commentaires, messages, partages et mentions.\nRégularité et qualité du calendrier de publication.\nPortée organique et impressions générées.\nNombre de leads ou opportunités générés depuis les communautés.\nCapacité à identifier rapidement les contenus performants et à améliorer la stratégie.</p>','Communication, Conflict Resolution, Community Building, Writing, Video Production, Graphic Design, Social Media Management, Data Analysis, Platform Management','2026-08-31 10:10:29',1,NULL,3,NULL,NULL,7,5,6,1800,30,NULL,NULL,4);
