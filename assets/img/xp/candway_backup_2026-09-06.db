DROP TABLE IF EXISTS `evaluation_results`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `evaluation_results` (
  `version_id` int NOT NULL DEFAULT '1',
  `id` int NOT NULL AUTO_INCREMENT,
  `evaluation_session_id` int NOT NULL,
  `rubric_id` int DEFAULT NULL,
  `rubric_version` int DEFAULT NULL,
  `cv_score` float DEFAULT NULL,
  `rubric_score` float DEFAULT NULL,
  `human_integrity_score` float DEFAULT '100',
  `rubric_coverage_pct` float DEFAULT NULL,
  `final_score` float DEFAULT NULL,
  `composite_score` float DEFAULT NULL,
  `confidence_lower` float DEFAULT NULL,
  `confidence_upper` float DEFAULT NULL,
  `score_breakdown` json DEFAULT NULL,
  `fraud_score` float DEFAULT '0',
  `fraud_reported_by` int DEFAULT NULL,
  `fraud_reported_at` datetime DEFAULT NULL,
  `scoring_model` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT 'rubric',
  `needs_review` tinyint(1) DEFAULT '0',
  `needs_review_reason` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `computed_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `computed_by` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `created_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `updated_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `verdict` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `scoring_status` varchar(20) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'PENDING',
  `company_id` int DEFAULT NULL,
  `rubric_snapshot_id` int DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `evaluation_session_id` (`evaluation_session_id`),
  KEY `idx_er_final_score` (`final_score`),
  KEY `idx_er_needs_review` (`needs_review`),
  KEY `ix_evaluation_results_verdict` (`verdict`),
  KEY `ix_evaluation_results_scoring_status` (`scoring_status`),
  KEY `idx_evaluation_results_company_id` (`company_id`),
  KEY `ix_evaluation_results_rubric_snapshot_id` (`rubric_snapshot_id`),
  KEY `fk_evaluation_results_rubric_id` (`rubric_id`),
  CONSTRAINT `evaluation_results_ibfk_1` FOREIGN KEY (`company_id`) REFERENCES `companies` (`id`),
  CONSTRAINT `fk_evaluation_results_evaluation_session_id` FOREIGN KEY (`evaluation_session_id`) REFERENCES `evaluation_sessions` (`id`) ON DELETE CASCADE,
  CONSTRAINT `fk_evaluation_results_rubric_id` FOREIGN KEY (`rubric_id`) REFERENCES `rubrics` (`id`) ON DELETE SET NULL,
  CONSTRAINT `fk_evaluation_results_rubric_snapshot_id` FOREIGN KEY (`rubric_snapshot_id`) REFERENCES `rubric_snapshots` (`id`) ON DELETE SET NULL,
  CONSTRAINT `ck_eval_result_composite_score_range` CHECK (((`composite_score` is null) or ((`composite_score` >= 0) and (`composite_score` <= 100)))),
  CONSTRAINT `ck_eval_result_coverage_range` CHECK (((`rubric_coverage_pct` is null) or ((`rubric_coverage_pct` >= 0) and (`rubric_coverage_pct` <= 100)))),
  CONSTRAINT `ck_eval_result_final_score_range` CHECK (((`final_score` is null) or ((`final_score` >= 0) and (`final_score` <= 100)))),
  CONSTRAINT `ck_eval_result_fraud_score_range` CHECK (((`fraud_score` is null) or ((`fraud_score` >= 0) and (`fraud_score` <= 100)))),
  CONSTRAINT `ck_eval_result_human_score_range` CHECK (((`human_integrity_score` is null) or ((`human_integrity_score` >= 0) and (`human_integrity_score` <= 100)))),
  CONSTRAINT `ck_eval_result_rubric_score_range` CHECK (((`rubric_score` is null) or ((`rubric_score` >= 0) and (`rubric_score` <= 100)))),
  CONSTRAINT `ck_eval_result_score_range` CHECK (((`cv_score` is null) or ((`cv_score` >= 0) and (`cv_score` <= 100)))),
  CONSTRAINT `ck_eval_result_scoring_status` CHECK ((`scoring_status` in (_utf8mb4'PENDING',_utf8mb4'SCORED',_utf8mb4'FAILED',_utf8mb4'NEEDS_REVIEW'))),
  CONSTRAINT `ck_eval_result_state_machine` CHECK ((((`scoring_status` = _utf8mb4'SCORED') and (`final_score` is not null)) or ((`scoring_status` in (_utf8mb4'PENDING',_utf8mb4'FAILED',_utf8mb4'NEEDS_REVIEW')) and (`final_score` is null))))
) ENGINE=InnoDB AUTO_INCREMENT=20 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
