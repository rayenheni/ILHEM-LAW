  CONSTRAINT `applications_ibfk_5` FOREIGN KEY (`company_id`) REFERENCES `companies` (`id`),
  CONSTRAINT `fk_app_rubric_new` FOREIGN KEY (`rubric_id`) REFERENCES `rubrics` (`id`),
  CONSTRAINT `fk_applications_batch_id` FOREIGN KEY (`batch_id`) REFERENCES `batch_jobs` (`id`) ON DELETE SET NULL,
  CONSTRAINT `fk_applications_candidate_id` FOREIGN KEY (`candidate_id`) REFERENCES `candidates` (`id`) ON DELETE RESTRICT,
  CONSTRAINT `fk_applications_company` FOREIGN KEY (`company_id`) REFERENCES `companies` (`id`),
  CONSTRAINT `fk_applications_job_id` FOREIGN KEY (`job_id`) REFERENCES `jobs` (`id`) ON DELETE SET NULL,
  CONSTRAINT `fk_applications_user_id` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE SET NULL,
  CONSTRAINT `ck_application_analysis_score_range` CHECK (((`analysis_score` is null) or ((`analysis_score` >= 0) and (`analysis_score` <= 100)))),
  CONSTRAINT `ck_application_evaluation_state` CHECK (((`evaluation_state` is null) or (`evaluation_state` in (_utf8mb4'pending',_utf8mb4'running',_utf8mb4'completed',_utf8mb4'failed',_utf8mb4'flagged',_utf8mb4'expired',_utf8mb4'override')))),
  CONSTRAINT `ck_application_status` CHECK (((`status` is null) or (`status` in (_utf8mb4'pending',_utf8mb4'screening',_utf8mb4'interviewing',_utf8mb4'offer',_utf8mb4'rejected',_utf8mb4'analyzed',_utf8mb4'failed',_utf8mb4'applied',_utf8mb4'invited',_utf8mb4'active',_utf8mb4'analyzing',_utf8mb4'analysis_failed',_utf8mb4'hired',_utf8mb4'offer_declined',_utf8mb4'withdrawn',_utf8mb4'imported',_utf8mb4'reviewed',_utf8mb4'shortlisted'))))
) ENGINE=InnoDB AUTO_INCREMENT=22 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

