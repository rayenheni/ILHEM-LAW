DROP TABLE IF EXISTS `background_check_status_logs`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `background_check_status_logs` (
  `id` int NOT NULL AUTO_INCREMENT,
  `background_check_id` int NOT NULL,
  `from_status` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `to_status` varchar(50) COLLATE utf8mb4_unicode_ci NOT NULL,
  `changed_by` int DEFAULT NULL,
  `details` text COLLATE utf8mb4_unicode_ci,
  `created_at` datetime DEFAULT NULL,
  `company_id` int NOT NULL,
  PRIMARY KEY (`id`),
  KEY `fk_bg_status_log_changed_by` (`changed_by`),
  KEY `idx_bg_status_log_check` (`background_check_id`),
  KEY `ix_background_check_status_logs_company_id` (`company_id`),
  CONSTRAINT `fk_bg_status_log_changed_by` FOREIGN KEY (`changed_by`) REFERENCES `users` (`id`),
  CONSTRAINT `fk_bg_status_log_check` FOREIGN KEY (`background_check_id`) REFERENCES `background_checks` (`id`),
  CONSTRAINT `fk_bg_status_log_company` FOREIGN KEY (`company_id`) REFERENCES `companies` (`id`) ON DELETE RESTRICT
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

