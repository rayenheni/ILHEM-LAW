INSERT INTO `rubrics` VALUES (1,NULL,1,'marketing lead','يُتوقع من Marketing Lead في تونس قيادة الاستراتيجية التسويقية للشركة وتوجيه الفريق التنفيذي (Designers, Copywriters, Community Managers) لتحقيق نمو ملموس في السوق المحلية أو الإقليمية. يوازن هذا الدور بين الجانب الإستراتيجي والتنفيذي، ويقاس نجاحه بالقدرة على رفع الوعي بالعلامة التجارية (Brand Awareness) وتوليد فرص مبيعات حقيقية (Leads) بأقل تكلفة ممكنة، مع فهم عميق لسلوك المستهلك التونسي.',0,100,1,'{\"categories\": [{\"name\": \"Technical Skills\", \"weight\": 50.0, \"subcategories\": [{\"name\": \"Skills\", \"weight\": 1.0, \"skills\": [{\"name\": \"marketing lead Core Expertise\", \"weight\": 40.0, \"is_required\": false, \"keywords\": [], \"level\": \"advanced\"}, {\"name\": \"Tools & Methodologies\", \"weight\": 30.0, \"is_required\": false, \"keywords\": [], \"level\": \"intermediate\"}, {\"name\": \"Problem Solving\", \"weight\": 30.0, \"is_required\": false, \"keywords\": [], \"level\": \"advanced\"}]}]}, {\"name\": \"Soft Skills\", \"weight\": 30.0, \"subcategories\": [{\"name\": \"Skills\", \"weight\": 1.0, \"skills\": [{\"name\": \"Communication\", \"weight\": 40.0, \"is_required\": false, \"keywords\": [], \"level\": \"intermediate\"}, {\"name\": \"Collaboration\", \"weight\": 30.0, \"is_required\": false, \"keywords\": [], \"level\": \"intermediate\"}, {\"name\": \"Adaptability\", \"weight\": 30.0, \"is_required\": false, \"keywords\": [], \"level\": \"intermediate\"}]}]}, {\"name\": \"Experience & Impact\", \"weight\": 20.0, \"subcategories\": [{\"name\": \"Skills\", \"weight\": 1.0, \"skills\": [{\"name\": \"Delivering Results\", \"weight\": 50.0, \"is_required\": false, \"keywords\": [], \"level\": \"advanced\"}, {\"name\": \"Leadership\", \"weight\": 50.0, \"is_required\": false, \"keywords\": [], \"level\": \"intermediate\"}]}]}]}',NULL,'mid',9,1,'2026-08-23 10:30:09','2026-08-23 10:30:09',4),(2,NULL,1,'hr specialist',NULL,0,100,1,'{\"categories\": [{\"name\": \"recruiter\", \"weight\": 100.0, \"subcategories\": [{\"name\": \"Skills\", \"weight\": 1.0, \"skills\": [{\"name\": \"management\", \"weight\": 100.0, \"is_required\": false, \"keywords\": [], \"level\": \"intermediate\"}]}]}]}',NULL,'mid',13,1,'2026-08-23 21:27:01','2026-08-23 21:27:01',4),(3,NULL,1,'HR Specialist manager','The HR Specialist is an execution-focused operational role. They manage daily human resources tasks, ensure smooth onboarding, maintain error-free employee records, and act as the first line of contact for staff inquiries. The ideal candidate balances meticulous attention to detail with strong interpersonal skills.Instructions for Rubric Generation:Structure: Create 4 main categories, each broken down into 2–3 specific, measurable skills.Weighting: Distribute a total weight of 100% across categories and individual skills based on operational importance.Proficiency Levels: For each skill, define 3 clear proficiency levels (Level 1: Needs Improvement, Level 2: Proficient, Level 3: Advanced/Exemplary) using actionable, behavior-based descriptions instead of generic adjectives.Key Themes to Include:End-to-end talent acquisition (sourcing, structured interviewing, and onboarding).Operational compliance (HRIS data accuracy, record keeping, and basic labor law alignment).Employee relations (resolving routine conflicts, building trust with team leaders).Workplace effic',0,100,1,'{\"categories\": [{\"name\": \"Talent Acquisition & Onboarding\", \"weight\": 30.0, \"subcategories\": [{\"name\": \"Skills\", \"weight\": 1.0, \"skills\": [{\"name\": \"Sourcing & Candidate Pipeline\", \"weight\": 10.0, \"is_required\": false, \"keywords\": [], \"level\": \"intermediate\"}, {\"name\": \"Structured Interviewing\", \"weight\": 10.0, \"is_required\": false, \"keywords\": [], \"level\": \"intermediate\"}, {\"name\": \"Onboarding Execution\", \"weight\": 10.0, \"is_required\": false, \"keywords\": [], \"level\": \"advanced\"}]}]}, {\"name\": \"Operational Compliance & HRIS Management\", \"weight\": 30.0, \"subcategories\": [{\"name\": \"Skills\", \"weight\": 1.0, \"skills\": [{\"name\": \"HRIS Data Accuracy\", \"weight\": 10.0, \"is_required\": false, \"keywords\": [], \"level\": \"advanced\"}, {\"name\": \"Record Keeping & Documentation\", \"weight\": 10.0, \"is_required\": false, \"keywords\": [], \"level\": \"advanced\"}, {\"name\": \"Basic Labor Law Alignment\", \"weight\": 10.0, \"is_required\": false, \"keywords\": [], \"level\": \"intermediate\"}]}]}, {\"name\": \"Employee Relations & Support\", \"weight\": 25.0, \"subcategories\": [{\"name\": \"Skills\", \"weight\": 1.0, \"skills\": [{\"name\": \"First\\u2011line Staff Inquiries\", \"weight\": 12.0, \"is_required\": false, \"keywords\": [], \"level\": \"intermediate\"}, {\"name\": \"Conflict Resolution & Mediation\", \"weight\": 13.0, \"is_required\": false, \"keywords\": [], \"level\": \"advanced\"}]}]}, {\"name\": \"Process Improvement & Reporting\", \"weight\": 15.0, \"subcategories\": [{\"name\": \"Skills\", \"weight\": 1.0, \"skills\": [{\"name\": \"Metrics Tracking & Reporting\", \"weight\": 8.0, \"is_required\": false, \"keywords\": [], \"level\": \"intermediate\"}, {\"name\": \"Continuous Process Optimization\", \"weight\": 7.0, \"is_required\": false, \"keywords\": [], \"level\": \"advanced\"}]}]}]}',NULL,'mid',15,1,'2026-08-24 06:00:56','2026-08-24 06:00:56',5),(4,NULL,1,'community manager',NULL,0,100,1,'{\"categories\": [{\"name\": \"Community Engagement\", \"weight\": 40.0, \"subcategories\": [{\"name\": \"Skills\", \"weight\": 1.0, \"skills\": [{\"name\": \"Communication\", \"weight\": 30.0, \"is_required\": false, \"keywords\": [], \"level\": \"intermediate\"}, {\"name\": \"Conflict Resolution\", \"weight\": 25.0, \"is_required\": false, \"keywords\": [], \"level\": \"intermediate\"}, {\"name\": \"Community Building\", \"weight\": 45.0, \"is_required\": false, \"keywords\": [], \"level\": \"advanced\"}]}]}, {\"name\": \"Content Creation\", \"weight\": 30.0, \"subcategories\": [{\"name\": \"Skills\", \"weight\": 1.0, \"skills\": [{\"name\": \"Writing\", \"weight\": 40.0, \"is_required\": false, \"keywords\": [], \"level\": \"intermediate\"}, {\"name\": \"Video Production\", \"weight\": 30.0, \"is_required\": false, \"keywords\": [], \"level\": \"beginner\"}, {\"name\": \"Graphic Design\", \"weight\": 30.0, \"is_required\": false, \"keywords\": [], \"level\": \"beginner\"}]}]}, {\"name\": \"Technical Skills\", \"weight\": 30.0, \"subcategories\": [{\"name\": \"Skills\", \"weight\": 1.0, \"skills\": [{\"name\": \"Social Media Management\", \"weight\": 50.0, \"is_required\": false, \"keywords\": [], \"level\": \"advanced\"}, {\"name\": \"Data Analysis\", \"weight\": 30.0, \"is_required\": false, \"keywords\": [], \"level\": \"intermediate\"}, {\"name\": \"Platform Management\", \"weight\": 20.0, \"is_required\": false, \"keywords\": [], \"level\": \"intermediate\"}]}]}]}',NULL,'mid',15,1,'2026-08-31 10:13:11','2026-08-31 10:13:11',5);
