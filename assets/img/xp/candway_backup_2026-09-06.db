DROP TABLE IF EXISTS `job_ai_configs`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `job_ai_configs` (
  `id` int NOT NULL AUTO_INCREMENT,
  `job_id` int NOT NULL,
  `company_id` int NOT NULL,
  `ai_scoring_enabled` tinyint(1) NOT NULL DEFAULT '1',
  `minimum_recommended_score` float NOT NULL DEFAULT '0',
  `auto_shortlist_threshold` float DEFAULT NULL,
  `auto_reject_threshold` float DEFAULT NULL,
  `explain_ai_decisions` tinyint(1) NOT NULL DEFAULT '1',
  `evidence_based_scoring` tinyint(1) NOT NULL DEFAULT '1',
  `ignore_missing_cv` tinyint(1) NOT NULL DEFAULT '0',
  `prioritize_verified_skills` tinyint(1) NOT NULL DEFAULT '1',
  `custom_instructions` text COLLATE utf8mb4_unicode_ci,
  `created_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `updated_at` datetime DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `ix_job_ai_configs_job_id` (`job_id`),
  UNIQUE KEY `idx_jac_job` (`job_id`),
  KEY `ix_job_ai_configs_company_id` (`company_id`),
  CONSTRAINT `fk_job_ai_configs_job_id` FOREIGN KEY (`job_id`) REFERENCES `jobs` (`id`) ON DELETE CASCADE,
  CONSTRAINT `job_ai_configs_ibfk_2` FOREIGN KEY (`company_id`) REFERENCES `companies` (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

--
-- Dumping data for table `job_ai_configs`
--

LOCK TABLES `job_ai_configs` WRITE;
/*!40000 ALTER TABLE `job_ai_configs` DISABLE KEYS */;
INSERT INTO `job_ai_configs` VALUES (1,1,4,1,60,80,30,1,1,0,1,'تتحكم القواعد التالية في طريقة تحليل وتقييم إجابات المترشحين:التقييم القائم على الأدلة (Evidence-Based Scoring): لا يتم احتساب أي مهارة أو خبرة ما لم يذكر المترشح دليلاً ملموساً عليها (مثال: أرقام حملات، أدوات مستخدمة مثل Meta Ads Manager، أو نسب نمو محققة).إعطاء الأولوية للمهارات التي تم التحقق منها (Prioritize Verified Skills): يتم منح وزن أعلى (Weight) في النقاط للمهارات المثبتة عبر اختبارات تقنية مسبقة أو مشاريع سابقة موثقة.تفسير القرارات (Explain AI Decisions): يلتزم النظام بتقديم تقرير تعليلي (Reasoning Breakdown) لكل درجة يتم منحها، يوضح نقاط القوة والفجوات بناءً على إجابة المترشح.','2026-08-23 10:37:47','2026-08-23 10:37:47'),(2,2,4,1,0,NULL,NULL,1,1,0,1,NULL,'2026-08-23 21:27:06','2026-08-23 21:27:06'),(3,3,5,1,70,85,50,1,1,0,1,'- **Startup Mindset:** Prioritize candidates with startup experience who can handle ambiguity, wear multiple hats, and thrive in fast-paced, rapidly changing environments.\n- **Tools over Theory:** Favor candidates with practical hands-on experience in modern HR platforms (e.g., Rippling, Gusto, BambooHR, Greenhouse) over theoretical strategic frameworks.\n- **Scrappiness & Ownership:** Look for a proactive \"builder\" mentality—someone who sets up systems from scratch rather than just maintaining existing corporate processes.\n- **Speed & Agility:** Emphasize high-volume sourcing speed, rapid interview scheduling, and fast turnaround times for employee requests.\n','2026-08-24 06:02:41','2026-08-24 06:02:41'),(4,4,5,1,0,NULL,NULL,1,1,0,1,NULL,'2026-08-31 10:13:18','2026-08-31 10:13:18');
/*!40000 ALTER TABLE `job_ai_configs` ENABLE KEYS */;
UNLOCK TABLES;

