--
-- Table structure for table `evaluation_sessions`
--

DROP TABLE IF EXISTS `evaluation_sessions`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `evaluation_sessions` (
  `version_id` int NOT NULL DEFAULT '1',
  `id` int NOT NULL AUTO_INCREMENT,
  `application_id` int NOT NULL,
  `candidate_id` int DEFAULT NULL,
  `context_type` varchar(50) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'job',
  `context_id` varchar(36) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `status` varchar(20) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'created',
  `language` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT 'English',
  `source` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `interview_state` varchar(20) COLLATE utf8mb4_unicode_ci DEFAULT 'not_started',
  `interview_progress` int DEFAULT '0',
  `interview_time_left` int DEFAULT '1800',
  `interview_last_saved` datetime DEFAULT NULL,
  `interview_log` json DEFAULT NULL,
  `interview_questions` json DEFAULT NULL,
  `generated_questions` json DEFAULT NULL,
  `proctoring_violations` json DEFAULT NULL,
  `video_file_path` varchar(512) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `video_transcript` text COLLATE utf8mb4_unicode_ci,
  `video_analysis_json` json DEFAULT NULL,
  `interview_reset_count` int DEFAULT '0',
  `interview_last_reset_at` datetime DEFAULT NULL,
  `interview_turn_seq` int DEFAULT '0',
  `calibration_json` json DEFAULT NULL,
  `calibration_score` float DEFAULT NULL,
  `calibration_verified_skills` json DEFAULT NULL,
  `rubric_id` int DEFAULT NULL,
  `rubric_version` int DEFAULT NULL,
  `started_at` datetime DEFAULT NULL,
  `completed_at` datetime DEFAULT NULL,
  `created_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `updated_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `company_id` int DEFAULT NULL,
  `rubric_snapshot_id` int DEFAULT NULL,
  `evaluation_config_snapshot_id` int DEFAULT NULL,
  `expires_at` datetime DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_es_app` (`application_id`),
  KEY `idx_es_candidate` (`candidate_id`),
  KEY `idx_es_context` (`context_type`,`context_id`),
  KEY `idx_es_status` (`status`),
  KEY `idx_es_company` (`company_id`),
  KEY `idx_es_app_status` (`application_id`,`status`),
  KEY `idx_es_app_interview_state` (`application_id`,`interview_state`),
  KEY `ix_evaluation_sessions_rubric_snapshot_id` (`rubric_snapshot_id`),
  KEY `ix_evaluation_sessions_evaluation_config_snapshot_id` (`evaluation_config_snapshot_id`),
  KEY `fk_evaluation_sessions_rubric_id` (`rubric_id`),
  KEY `ix_evaluation_sessions_expires_at` (`expires_at`),
  CONSTRAINT `fk_evaluation_sessions_application_id` FOREIGN KEY (`application_id`) REFERENCES `applications` (`id`) ON DELETE CASCADE,
  CONSTRAINT `fk_evaluation_sessions_candidate_id` FOREIGN KEY (`candidate_id`) REFERENCES `candidate_profiles` (`id`) ON DELETE SET NULL,
  CONSTRAINT `fk_evaluation_sessions_company` FOREIGN KEY (`company_id`) REFERENCES `companies` (`id`),
  CONSTRAINT `fk_evaluation_sessions_company_id` FOREIGN KEY (`company_id`) REFERENCES `companies` (`id`) ON DELETE RESTRICT,
  CONSTRAINT `fk_evaluation_sessions_evaluation_config_snapshot_id` FOREIGN KEY (`evaluation_config_snapshot_id`) REFERENCES `evaluation_config_snapshots` (`id`) ON DELETE SET NULL,
  CONSTRAINT `fk_evaluation_sessions_rubric_id` FOREIGN KEY (`rubric_id`) REFERENCES `rubrics` (`id`) ON DELETE SET NULL,
  CONSTRAINT `fk_evaluation_sessions_rubric_snapshot_id` FOREIGN KEY (`rubric_snapshot_id`) REFERENCES `rubric_snapshots` (`id`) ON DELETE SET NULL,
  CONSTRAINT `ck_eval_session_interview_state` CHECK (((`interview_state` is null) or (`interview_state` in (_utf8mb4'not_started',_utf8mb4'in_progress',_utf8mb4'completed',_utf8mb4'expired',_utf8mb4'flagged',_utf8mb4'paused')))),
  CONSTRAINT `ck_eval_session_status` CHECK (((`status` is null) or (`status` in (_utf8mb4'created',_utf8mb4'in_progress',_utf8mb4'paused',_utf8mb4'completed',_utf8mb4'expired',_utf8mb4'failed',_utf8mb4'running',_utf8mb4'pending',_utf8mb4'flagged',_utf8mb4'needs_review'))))
) ENGINE=InnoDB AUTO_INCREMENT=22 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
